{
  "name": "libpng",
  "buildsystem": "cmake-ninja",
  "builddir": true,
  "config-opts": [
    "-DPNG_TESTS=OFF",
    "-DPNG_STATIC=OFF",
    "-DPNG_SHARED=ON",
    "-DPNG_TOOLS=OFF"
  ],
  "build-options": {
    "strip": true
  },
  "sources": [
    {
      "type": "archive",
      "url": "https://downloads.sourceforge.net/project/libpng/libpng16/1.6.59/libpng-1.6.59.tar.xz",
      "sha256": "d80dd2a38a37f803cb9b6ac7b14bd6e74ddc3b654780a8380bdf93523fdb4389"
    },
    {
      "type": "file",
      "url": "https://download.sourceforge.net/libpng-apng/libpng-1.6.59-apng.patch.gz",
      "dest-filename": "libpng-1.6.59-apng.patch.gz",
      "sha256": "29693a9c9953ca1e88e25401ee500ed959e73f93dc98163fa967df71d3e7a990"
    },
    {
      "type": "shell",
      "commands":
      [
          "gunzip -f libpng-1.6.59-apng.patch.gz",
          "patch -p1  < \"libpng-1.6.59-apng.patch\""
      ]
    }
  ],
  "cleanup": [
    "/bin",
    "/include",
    "/lib/*.a",
    "/lib/*.la",
    "/lib/cmake",
    "/lib/libpng",
    "/lib/pkgconfig",
    "/share/man"
  ]
}

